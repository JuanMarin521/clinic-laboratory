{
  "expo": {
    "name": "CPO Conecta",
    "slug": "clinicLaboratory",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#040B19",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.juanpablorz.cliniclaboratory",
      "adaptiveIcon": {
        "backgroundColor": "#040B19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CPO Conecta usa Face ID para que ingreses de forma segura sin escribir tu contraseña."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "CPO Conecta usa Face ID para proteger tu credencial de ingreso."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": { "usesCleartextTraffic": true }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a7de65d-390e-4f38-85bb-0c273b85f353"
      }
    }
  }
}
